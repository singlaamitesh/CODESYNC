# Copy this file to deploy/.env on the droplet and fill in real values.

# Your domain (Caddy uses this for automatic HTTPS).
DOMAIN=codesync.amitesh.tech

# Public URL used by FastAPI for constructing absolute links.
FRONTEND_URL=https://codesync.amitesh.tech

# AI provider key (OpenRouter works with the existing ai_service.py).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Embeddings for semantic search (defaults to OpenRouter's free Nemotron model).
# Reuses OPENROUTER_API_KEY above unless EMBEDDINGS_API_KEY is set explicitly.
# Leave the API key empty to disable search; everything else still works.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# PocketBase admin (created on first boot). FastAPI uses these to write embeddings server-side.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-please
